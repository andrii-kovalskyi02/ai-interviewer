{
    "name": "ai-interviewer",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "concurrently -n server,web -c blue,green \"npm run dev -w @interviewer/server\" \"npm run dev -w @interviewer/web\"",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test -w @interviewer/server",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "concurrently": "^10.0.3",
        "prettier": "^3.9.6"
    },
    "overrides": {
        "shell-quote": "^1.10.0"
    },
    "allowScripts": {
        "esbuild@0.28.1": true,
        "fsevents@2.3.3": true
    }
}
